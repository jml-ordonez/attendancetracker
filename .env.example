# ==============================================================================
# Business Administration Dynamic QR Attendance System - Environment Variables
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3DES Cryptographic Compatibility Configuration (Strictly Server-Only)
# QR_3DES_SECRET_KEY: Exactly 24 bytes (48 hex chars or 32 base64 chars) for des-ede3-cbc
QR_3DES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef

# Encrypt-Then-MAC Authentication Key (Strictly Server-Only)
# QR_HMAC_SECRET_KEY: 32 bytes (64 hex chars) for HMAC-SHA256 integrity verification
QR_HMAC_SECRET_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Active Key Identifier (supports key rotation)
QR_KEY_VERSION=k1

# Dynamic QR Expiry in Seconds (Default: 45 seconds)
NEXT_PUBLIC_QR_EXPIRY_SECONDS=45

# App Configuration
NEXT_PUBLIC_APP_NAME="Business Administration Dynamic QR Attendance System"
NEXT_PUBLIC_APP_URL=http://localhost:3000
